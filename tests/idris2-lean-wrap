#!/usr/bin/env bash
# idris2 front end that always uses the lean backend (drops any --cg/--codegen X)
HERE="$(cd "$(dirname "$0")" && pwd)"
args=(); skip=0
for a in "$@"; do
  if [ $skip = 1 ]; then skip=0; continue; fi
  case "$a" in --cg|--codegen) skip=1;; *) args+=("$a");; esac
done
exec "${IDRIS2_LEAN:-$HERE/../build/exec/idris2-lean}" --cg lean "${args[@]}"
